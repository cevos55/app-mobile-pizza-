<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"

        android:padding="16dp">


        <ImageView
            android:id="@+id/imgPizza"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:scaleType="centerCrop"
            android:contentDescription="@string/image_de_la_pizza"
            android:src="@drawable/pizza_default" />

        <TextView
            android:id="@+id/txtPizzaName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/imgPizza"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/imgPizza"
            android:text="@string/pizza_reine"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPizzaDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtPizzaName"
            android:layout_toEndOf="@id/imgPizza"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:text="@string/mozzarella_jambon_champignons"
            android:textSize="14sp"
            android:textColor="@color/dark_gray" />

        <TextView
            android:id="@+id/txtPizzaPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/txtPizzaName"
            android:text="@string/_5000_fcfa"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/purple_500" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCart"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/txtPizzaDescription"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/purple_500"
            android:text="@string/ajouter"
            android:textColor="@android:color/white"
            app:cornerRadius="16dp" />
    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
